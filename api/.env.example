# Copie este arquivo para ".env" no servidor (VPS) e preencha com os valores reais.
# NUNCA coloque a senha real aqui neste arquivo de exemplo, nem faça commit do .env real.

# Connection string completa do Postgres (host, porta, usuario, senha, banco).
# Formato: postgres://usuario:senha@host:porta/banco
DATABASE_URL=postgres://usuario:senha@host:porta/banco

# Schema onde a tabela do quiz vive (nao eh o "public" padrao)
DB_SCHEMA=Quiz

# Porta que o servidor Node vai escutar
PORT=3300

# Origem(ns) permitida(s) para CORS - o dominio onde o quiz-hormonal-v2.html for hospedado
CORS_ORIGIN=https://seu-dominio-do-quiz.com
